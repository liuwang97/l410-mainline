+/// fentry/fexit attach through BPF trampolines needs the function tracer (patchable
+/// function entries); without it the kernel has no available_filter_functions. Only
+/// tracefs is looked at: touching /sys/kernel/debug/tracing makes the kernel automount
+/// tracefs there and log "Automounting of tracing to debugfs is deprecated".
+pub fn fentry_supported() -> bool {
+    std::path::Path::new("/sys/kernel/tracing/available_filter_functions").exists()
+}
