 src/evdev-mt-touchpad-gestures.c     |   1 +
 src/evdev-mt-touchpad-scroll-accel.c | 221 +++++++++++++++++++++++++++
 src/evdev-mt-touchpad.c              |  13 +-
 src/evdev-mt-touchpad.h              |  37 +++++
 5 files changed, 268 insertions(+), 5 deletions(-)
